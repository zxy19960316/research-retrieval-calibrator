{
  "FeedbackRecord": {
    "$defs": {
      "FeedbackAspect": {
        "enum": [
          "OBJECT",
          "TASK",
          "METHOD",
          "PHYSICS",
          "BRIDGE",
          "EVALUATION"
        ],
        "title": "FeedbackAspect",
        "type": "string"
      },
      "Relevance": {
        "enum": [
          "HIGH",
          "PARTIAL",
          "IRRELEVANT"
        ],
        "title": "Relevance",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "aspects": {
        "items": {
          "$ref": "#/$defs/FeedbackAspect"
        },
        "title": "Aspects",
        "type": "array"
      },
      "created_at": {
        "format": "date-time",
        "title": "Created At",
        "type": "string"
      },
      "paper_id": {
        "minLength": 1,
        "title": "Paper Id",
        "type": "string"
      },
      "project_id": {
        "pattern": "^RRC-\\d{4}-\\d{4}$",
        "title": "Project Id",
        "type": "string"
      },
      "raw_text": {
        "minLength": 1,
        "title": "Raw Text",
        "type": "string"
      },
      "relevance": {
        "$ref": "#/$defs/Relevance"
      }
    },
    "required": [
      "project_id",
      "paper_id",
      "relevance",
      "raw_text"
    ],
    "title": "FeedbackRecord",
    "type": "object"
  },
  "PaperRecord": {
    "additionalProperties": false,
    "properties": {
      "abstract": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Abstract"
      },
      "authors": {
        "items": {
          "type": "string"
        },
        "title": "Authors",
        "type": "array"
      },
      "doi": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Doi"
      },
      "language": {
        "pattern": "^(zh|en)$",
        "title": "Language",
        "type": "string"
      },
      "paper_id": {
        "minLength": 1,
        "title": "Paper Id",
        "type": "string"
      },
      "retrieval_paths": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Retrieval Paths",
        "type": "array"
      },
      "source": {
        "minLength": 1,
        "title": "Source",
        "type": "string"
      },
      "source_id": {
        "title": "Source Id",
        "type": "string"
      },
      "title": {
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "url": {
        "title": "Url",
        "type": "string"
      },
      "user_visible": {
        "default": false,
        "title": "User Visible",
        "type": "boolean"
      },
      "year": {
        "anyOf": [
          {
            "maximum": 2100,
            "minimum": 1900,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Year"
      }
    },
    "required": [
      "paper_id",
      "source",
      "source_id",
      "title",
      "url",
      "language",
      "retrieval_paths"
    ],
    "title": "PaperRecord",
    "type": "object"
  },
  "Query": {
    "$defs": {
      "QueryBranch": {
        "enum": [
          "DIRECT_INTERSECTION",
          "PROBLEM_DOMAIN",
          "METHOD_DOMAIN",
          "BRIDGE_DOMAIN"
        ],
        "title": "QueryBranch",
        "type": "string"
      },
      "QueryBreadth": {
        "enum": [
          "NARROW",
          "MEDIUM",
          "WIDE"
        ],
        "title": "QueryBreadth",
        "type": "string"
      },
      "QueryRevision": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "rule": {
            "minLength": 1,
            "title": "Rule",
            "type": "string"
          },
          "source_paper_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Paper Id"
          }
        },
        "required": [
          "rule",
          "reason"
        ],
        "title": "QueryRevision",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "branch": {
        "$ref": "#/$defs/QueryBranch"
      },
      "breadth": {
        "$ref": "#/$defs/QueryBreadth"
      },
      "language": {
        "pattern": "^(zh|en)$",
        "title": "Language",
        "type": "string"
      },
      "query_id": {
        "minLength": 1,
        "title": "Query Id",
        "type": "string"
      },
      "query_text": {
        "minLength": 1,
        "title": "Query Text",
        "type": "string"
      },
      "revision_sources": {
        "items": {
          "$ref": "#/$defs/QueryRevision"
        },
        "title": "Revision Sources",
        "type": "array"
      },
      "round_number": {
        "maximum": 2,
        "minimum": 1,
        "title": "Round Number",
        "type": "integer"
      },
      "weight": {
        "maximum": 1,
        "minimum": 0,
        "title": "Weight",
        "type": "number"
      }
    },
    "required": [
      "query_id",
      "round_number",
      "branch",
      "breadth",
      "language",
      "query_text",
      "weight"
    ],
    "title": "Query",
    "type": "object"
  },
  "QueryRevision": {
    "additionalProperties": false,
    "properties": {
      "reason": {
        "minLength": 1,
        "title": "Reason",
        "type": "string"
      },
      "rule": {
        "minLength": 1,
        "title": "Rule",
        "type": "string"
      },
      "source_paper_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Source Paper Id"
      }
    },
    "required": [
      "rule",
      "reason"
    ],
    "title": "QueryRevision",
    "type": "object"
  },
  "ResearchIntent": {
    "$defs": {
      "MethodConstraint": {
        "enum": [
          "REQUIRED",
          "PREFERRED",
          "OPEN"
        ],
        "title": "MethodConstraint",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "accepted_paper_roles": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Accepted Paper Roles",
        "type": "array",
        "uniqueItems": true
      },
      "exclusions": {
        "items": {
          "type": "string"
        },
        "title": "Exclusions",
        "type": "array"
      },
      "frozen_at": {
        "format": "date-time",
        "title": "Frozen At",
        "type": "string"
      },
      "method_constraint": {
        "$ref": "#/$defs/MethodConstraint"
      },
      "method_terms": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Method Terms",
        "type": "array"
      },
      "object_terms": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Object Terms",
        "type": "array"
      },
      "revision": {
        "minimum": 1,
        "title": "Revision",
        "type": "integer"
      },
      "scope_terms": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Scope Terms",
        "type": "array"
      },
      "task_terms": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Task Terms",
        "type": "array"
      }
    },
    "required": [
      "object_terms",
      "task_terms",
      "method_terms",
      "scope_terms",
      "method_constraint",
      "accepted_paper_roles",
      "revision",
      "frozen_at"
    ],
    "title": "ResearchIntent",
    "type": "object"
  },
  "RetrievalProject": {
    "$defs": {
      "MethodConstraint": {
        "enum": [
          "REQUIRED",
          "PREFERRED",
          "OPEN"
        ],
        "title": "MethodConstraint",
        "type": "string"
      },
      "ProjectStage": {
        "enum": [
          "INIT",
          "CLARIFYING",
          "ROUND1_SEARCHING",
          "WAITING_FOR_FEEDBACK",
          "ROUND2_SEARCHING",
          "WAITING_FOR_DIRECTION_CONFIRMATION",
          "FINALIZED"
        ],
        "title": "ProjectStage",
        "type": "string"
      },
      "ResearchIntent": {
        "additionalProperties": false,
        "properties": {
          "accepted_paper_roles": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Accepted Paper Roles",
            "type": "array",
            "uniqueItems": true
          },
          "exclusions": {
            "items": {
              "type": "string"
            },
            "title": "Exclusions",
            "type": "array"
          },
          "frozen_at": {
            "format": "date-time",
            "title": "Frozen At",
            "type": "string"
          },
          "method_constraint": {
            "$ref": "#/$defs/MethodConstraint"
          },
          "method_terms": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Method Terms",
            "type": "array"
          },
          "object_terms": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Object Terms",
            "type": "array"
          },
          "revision": {
            "minimum": 1,
            "title": "Revision",
            "type": "integer"
          },
          "scope_terms": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Scope Terms",
            "type": "array"
          },
          "task_terms": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Task Terms",
            "type": "array"
          }
        },
        "required": [
          "object_terms",
          "task_terms",
          "method_terms",
          "scope_terms",
          "method_constraint",
          "accepted_paper_roles",
          "revision",
          "frozen_at"
        ],
        "title": "ResearchIntent",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "created_at": {
        "format": "date-time",
        "title": "Created At",
        "type": "string"
      },
      "current_intent": {
        "anyOf": [
          {
            "$ref": "#/$defs/ResearchIntent"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "final_selection_ids": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Final Selection Ids"
      },
      "original_input": {
        "minLength": 1,
        "title": "Original Input",
        "type": "string"
      },
      "project_id": {
        "pattern": "^RRC-\\d{4}-\\d{4}$",
        "title": "Project Id",
        "type": "string"
      },
      "round1_selection_ids": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Round1 Selection Ids"
      },
      "round_number": {
        "maximum": 2,
        "minimum": 0,
        "title": "Round Number",
        "type": "integer"
      },
      "stage": {
        "$ref": "#/$defs/ProjectStage"
      },
      "updated_at": {
        "format": "date-time",
        "title": "Updated At",
        "type": "string"
      }
    },
    "required": [
      "project_id",
      "stage",
      "round_number",
      "original_input"
    ],
    "title": "RetrievalProject",
    "type": "object"
  }
}
