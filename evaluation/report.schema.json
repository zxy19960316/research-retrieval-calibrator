{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-retrieval-calibrator.local/schemas/m0-report-0.1.json",
  "title": "Research Retrieval Calibrator phase evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "validated_commit",
    "generated_at_utc",
    "python_version",
    "task_evidence",
    "checks",
    "validated_inputs",
    "external_boundaries",
    "status_transition"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "phase": {"const": "M0"},
    "validated_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generated_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "python_version": {"type": "string", "pattern": "^3\\.12\\.\\d+$"},
    "task_evidence": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/taskEvidence"}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "validated_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/validatedInput"}
    },
    "external_boundaries": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/check"}
    },
    "status_transition": {"$ref": "#/$defs/statusTransition"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "taskEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "status", "source_reports", "source_report_sha256"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^M0-T\\d{2}$"},
        "status": {"const": "passed"},
        "source_reports": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_report_sha256": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceHash"}
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidence_type", "status"],
      "properties": {
        "name": {"type": "string", "pattern": ".*\\S.*"},
        "evidence_type": {
          "enum": ["automated", "mock", "recorded_external", "real_external", "human_judged", "not_run"]
        },
        "status": {"enum": ["passed", "failed", "not_run"]},
        "command": {"type": "string", "pattern": ".*\\S.*"},
        "operation_id": {"type": "string", "pattern": ".*\\S.*"},
        "exit_code": {"type": "integer"},
        "observed_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "source": {"type": "string", "pattern": ".*\\S.*"},
        "provenance": {"type": "string", "pattern": ".*\\S.*"},
        "judge": {"type": "string", "pattern": ".*\\S.*"},
        "judgment_version": {"type": "string", "pattern": ".*\\S.*"},
        "source_snapshot": {"type": "string", "pattern": ".*\\S.*"},
        "reason": {"type": "string", "pattern": ".*\\S.*"}
      },
      "allOf": [
        {
          "if": {"properties": {"evidence_type": {"const": "automated"}, "status": {"const": "passed"}}, "required": ["evidence_type", "status"]},
          "then": {"required": ["command", "exit_code", "observed_at_utc"], "properties": {"exit_code": {"const": 0}}}
        },
        {
          "if": {"properties": {"evidence_type": {"const": "automated"}, "status": {"const": "failed"}}, "required": ["evidence_type", "status"]},
          "then": {"required": ["command", "exit_code"], "properties": {"exit_code": {"not": {"const": 0}}}}
        },
        {
          "if": {"properties": {"evidence_type": {"const": "not_run"}}, "required": ["evidence_type"]},
          "then": {"required": ["reason"], "properties": {"status": {"const": "not_run"}}}
        },
        {
          "if": {"properties": {"evidence_type": {"const": "real_external"}, "status": {"const": "passed"}}, "required": ["evidence_type", "status"]},
          "then": {"required": ["observed_at_utc", "source", "provenance"], "anyOf": [{"required": ["command"]}, {"required": ["operation_id"]}]}
        },
        {
          "if": {"properties": {"evidence_type": {"const": "human_judged"}, "status": {"const": "passed"}}, "required": ["evidence_type", "status"]},
          "then": {"required": ["judge", "judgment_version", "source_snapshot"]}
        }
      ]
    },
    "validatedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_phase", "current_status", "m0_tasks", "m1_status", "m1_tasks"],
      "properties": {
        "current_phase": {"enum": ["M0", "M1"]},
        "current_status": {"enum": ["IN_PROGRESS", "READY"]},
        "m0_tasks": {"enum": ["3/4", "4/4"]},
        "m1_status": {"enum": ["BLOCKED_BY_M0", "READY"]},
        "m1_tasks": {"const": "0/4"}
      }
    },
    "statusTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/state"},
        "to": {"$ref": "#/$defs/state"}
      }
    }
  }
}
